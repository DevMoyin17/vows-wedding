# VOWS — environment
# Supabase (RSVP management). Create a project, run supabase/schema.sql.
# Use the anon / publishable key here — never the service_role/secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary (wedding photographs). Photos are served with f_auto,q_auto.
# Public ids live in src/lib/wedding.js under `photos[].cloud`.
VITE_CLOUDINARY_CLOUD_NAME=

# Optional: Google Maps API key only if you later embed maps.
# Venue navigation links work without a key via Google Maps URLs.
VITE_GOOGLE_MAPS_API_KEY=
